  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <TreatWarningAsError>false</TreatWarningAsError>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <!-- ⚠ Debug 产物不再被程序加载 (见 main.cpp installAndStartNetFilter, 只取
         x64\Release\ZETA_NetFilter.sys). Debug 下 sizeof(IO_REMOVE_LOCK)=0x78,
         IoReleaseRemoveLockAndWait 会走 nt 的调试追踪分支 → 卸载蓝屏 0x7E,
         该构建仅供内核调试用; 这里仍签名只是为了手工调试时不被代码完整性拒绝 (577) -->
    <PostBuildEvent>
      <Message>Signing ZETA_NetFilter.sys (Debug, ZETA test certificate)</Message>
      <!-- 单行命令: 本工程文件为 LF 换行, 多行 cmd 会被逐行拆散导致签名失败 -->
      <Command>if exist "C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\signtool.exe" ("C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\signtool.exe" sign /fd sha256 /sha1 340E9FFBE504FBA88F454F84CCCF8B4B40A95D68 /s My "$(TargetPath)") else ("C:\Program Files (x86)\Windows Kits\10\bin\10.0.22621.0\x64\signtool.exe" sign /fd sha256 /sha1 340E9FFBE504FBA88F454F84CCCF8B4B40A95D68 /s My "$(TargetPath)")</Command>
    </PostBuildEvent>
    <Link>
      <AdditionalDependencies>$(DDK_LIB_PATH)ntoskrnl.lib;$(DDK_LIB_PATH)hal.lib;$(DDK_LIB_PATH)wdmsec.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <TreatWarningAsError>false</TreatWarningAsError>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <!-- 构建事件必须放在 ItemDefinitionGroup 内 (写成 PropertyGroup 时
         %(PostBuildEvent.Command) 为空, 旧工程因此从未真正签名) -->
    <PostBuildEvent>
      <Message>Signing ZETA_NetFilter.sys (ZETA test certificate)</Message>
      <!-- 单行命令: 本工程文件为 LF 换行, 多行 cmd 会被逐行拆散导致签名失败 -->
      <Command>if exist "C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\signtool.exe" ("C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\signtool.exe" sign /fd sha256 /sha1 340E9FFBE504FBA88F454F84CCCF8B4B40A95D68 /s My "$(TargetPath)") else ("C:\Program Files (x86)\Windows Kits\10\bin\10.0.22621.0\x64\signtool.exe" sign /fd sha256 /sha1 340E9FFBE504FBA88F454F84CCCF8B4B40A95D68 /s My "$(TargetPath)")</Command>
    </PostBuildEvent>
    <Link>
      <AdditionalDependencies>$(DDK_LIB_PATH)ntoskrnl.lib;$(DDK_LIB_PATH)hal.lib;$(DDK_LIB_PATH)wdmsec.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
