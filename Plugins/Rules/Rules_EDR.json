{
    "//": "EDR 引擎通过多个检测维度综合评分，超过阈值则判定为威胁",
    "Rule_Pe_HighRiskApis": [
        "CreateRemoteThread",
        "WriteProcessMemory",
        "VirtualAllocEx",
        "SetWindowsHookEx",
        "GetAsyncKeyState",
        "keybd_event",
        "SendInput",
        "NtCreateProcess",
        "NtUnmapViewOfSection"
    ],
    "Rule_Pe_SuspiciousApis": [
        "VirtualAlloc",
        "VirtualProtect",
        "WriteProcessMemory",
        "CreateRemoteThread",
        "ShellExecute",
        "WinExec",
        "CreateProcess",
        "URLDownloadToFile",
        "DeleteFile",
        "RegCreateKeyEx",
        "RegSetValueEx",
        "GetProcAddress",
        "LoadLibrary",
        "ExitProcess"
    ],
    "Rule_Pe_SuspiciousSections": [
        ".upx",
        ".pack",
        ".themida",
        ".vmp",
        ".aspack",
        ".nsp0",
        ".nsp1",
        ".nsp2",
        ".mackt",
        ".kpack",
        ".winapi"
    ],
    "Rule_Scanning_Enabled": {
        "enable_entropy_analysis": true,
        "enable_pe_heuristics": true,
        "enable_signature_check": true,
        "enable_yara": true
    },
    "Rule_Scoring": {
        "high_entropy_score": 25,
        "high_risk_api_score": 30,
        "high_threat_threshold": 70,
        "no_entry_point_score": 10,
        "rwx_section_score": 20,
        "suspicious_api_score": 16,
        "suspicious_section_score": 30,
        "threat_threshold": 50,
        "unsigned_score": 20,
        "yara_match_score": 100
    },
    "Rule_Signature_RequiredExtensions": [
        ".exe",
        ".dll",
        ".scr",
        ".sys",
        ".msi",
        ".cab"
    ],
    "Rule_Signature_TrustedPublishers": [
        "Microsoft Corporation",
        "Google LLC",
        "Mozilla Corporation",
        "Apple Inc.",
        "Oracle Corporation",
        "Adobe Inc.",
        "Intel Corporation"
    ],
    "Rule_Yara_Paths": [
        "Plugins/Rules/YARA/*.yar",
        "Plugins/Rules/YARA/*.yara"
    ]
}
