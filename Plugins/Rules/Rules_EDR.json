{
    "//": "EDR 引擎通过多个检测维度综合评分，超过阈值则判定为威胁",
    "//Rule_Yara_Paths_NOTE": "路径拼接曾因 rulesDir + 该值 形成双重前缀，导致规则永不加载；现值为 YARA\\\\*.yar（相对 Plugins/Rules 递归收集，放 community/ 子目录也可）。2026-10-03 记录的那次崩溃(ZETA_Engine.dll+0x7486) 已在后续修好：2026-10-06 实测 1095 个规则文件 / 约 15k 条规则可正常编译加载，启动 45 秒无崩溃。",
    "Rule_Pe_HighRiskApis": [
        "CreateRemoteThread",
        "WriteProcessMemory",
        "VirtualAllocEx",
        "SetWindowsHookEx",
        "GetAsyncKeyState",
        "keybd_event",
        "SendInput",
        "NtCreateProcess",
        "NtUnmapViewOfSection"
    ],
    "Rule_Pe_SuspiciousApis": [
        "VirtualAlloc",
        "VirtualProtect",
        "WriteProcessMemory",
        "CreateRemoteThread",
        "ShellExecute",
        "WinExec",
        "CreateProcess",
        "URLDownloadToFile",
        "DeleteFile",
        "RegCreateKeyEx",
        "RegSetValueEx",
        "GetProcAddress",
        "LoadLibrary",
        "ExitProcess"
    ],
    "Rule_Pe_SuspiciousSections": [
        ".upx",
        ".pack",
        ".themida",
        ".vmp",
        ".aspack",
        ".nsp0",
        ".nsp1",
        ".nsp2",
        ".mackt",
        ".kpack",
        ".winapi"
    ],
    "Rule_Scanning_Enabled": {
        "enable_pe_heuristics": true,
        "enable_signature_check": true,
        "enable_yara": true
    },
    "//Rule_Scoring_note": "PE 扫描阈值(threat_*/high_threat_*)在 scanner.cpp 使用；yara_* 六项由 behavior_engine 的 loadYaraScoreConfig 读取，是 YARA 证据权重的唯一来源(2026-10-06 起 JSON 可调)。",
    "Rule_Scoring": {
        "high_entropy_score": 25,
        "high_risk_api_score": 30,
        "high_threat_threshold": 70,
        "no_entry_point_score": 10,
        "rwx_section_score": 20,
        "suspicious_api_score": 10,
        "suspicious_section_score": 30,
        "threat_threshold": 50,
        "unsigned_score": 20,

        "//yara_match_score": "已废弃(2026-10-04 起)：旧单值改为分档加权后，此字段不再被任何代码读取。保留仅作迁移提示，改它不会有任何效果。真正的权重见下面 yara_* 六项。",
        "yara_match_score": 100,

        "//yara_tier_note": "分档权重。弱档=能力型/库型目录(IsPE64/with_urls/crypto 常量等)，普通档=一般检测规则，强档=策展家族签名(mal_/apt_/crime_/rat_/spy_/expl_)。不变式(运行时校验，违反打 WARN)：弱档累计<WARN(40)；普通档累计<ALERT(85)且<WARN(40)；强档单发>=ALERT(85)。",
        "yara_weak_per_hit": 5,
        "yara_weak_cap": 15,
        "yara_normal_per_hit": 20,
        "yara_normal_cap": 35,
        "yara_strong_per_hit": 100,
        "yara_structural_suspicious": 20
    },
    "Rule_Signature_RequiredExtensions": [
        ".exe",
        ".dll",
        ".scr",
        ".sys",
        ".msi",
        ".cab"
    ],
    "Rule_Signature_TrustedPublishers": [
        "Microsoft Corporation",
        "Google LLC",
        "Mozilla Corporation",
        "Apple Inc.",
        "Oracle Corporation",
        "Adobe Inc.",
        "Intel Corporation"
    ],
    "Rule_Yara_Paths": [
        "YARA\\*.yar"
    ]
}
